# Aiven PostgreSQL (Fase 0 — isi dari Service Overview Aiven, JANGAN commit .env)
DATABASE_URL=postgres://user:***@host:port/dbname?sslmode=require

# Session cookie HMAC signing — WAJIB diisi secret acak di production.
# Ganti dengan nilai acak panjang (contoh: openssl rand -hex 32)
SESSION_SECRET=change-me

# Panitia (admin) — wajib diganti di produksi
PANITIA_USER=admin
PANITIA_PASS=admin123

# Tim Audit (non-admin) — wajib diganti di produksi
AUDIT_USER=audit
AUDIT_PASS=audit123
